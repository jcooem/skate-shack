# Copy to .env for local development. Never commit .env.

# ── Database (Neon) ───────────────────────────────────────────
# Pooled connection string (Neon "Connection pooling" ON) — used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (pooling OFF) — used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Tip: for local-only development you can run `npx prisma dev` instead and
# paste the postgres://… URL it prints into both variables.

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# These emails become the owner (admin) after confirming their address.
OWNER_EMAILS="you@example.com"

# ── Email (Resend) ────────────────────────────────────────────
# Leave RESEND_API_KEY empty locally: emails are printed to the terminal instead.
RESEND_API_KEY=""
EMAIL_FROM="Skate Shack <hello@yourdomain.com>"

# ── Social sign-in (optional — blank = button hidden) ─────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── Display ───────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY="CAD"
NEXT_PUBLIC_LOCALE="en-CA"
APP_TIMEZONE="America/Toronto"
